---
import Avatar from './Avatar.astro';
import type { SanityImageSource } from '@sanity/image-url';

export interface GroupMember {
    name: string;
    avatar?: SanityImageSource;
    avatarUrl?: string;
    priority?: number;
}

interface Props {
    members?: GroupMember[];
    limit?: number;
    size?: 'sm' | 'md' | 'lg';
    class?: string;
    reserveCountSpace?: boolean;
    loading?: 'lazy' | 'eager';
}

const {
    members = [],
    limit,
    size = 'sm',
    class: className,
    reserveCountSpace = false,
    loading = 'eager',
} = Astro.props;

// 1. Sort members by priority descending (highest priority first: [P_high, P_mid, P_low, ...])
const sorted = [...members].sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0));

// 2. Take top N members based on limit
const topMembers = typeof limit === 'number' && limit > 0
    ? sorted.slice(0, limit)
    : sorted;

// 3. Count remaining
const remainingCount = typeof limit === 'number' && limit > 0
    ? Math.max(0, sorted.length - limit)
    : 0;

// 4. Order right-to-left: highest priority on far right, stacking on top of lower priorities
// Reversing topMembers puts the lowest visible in front of DOM (left) and highest last in DOM (right),
// naturally stacking higher priorities on top of lower ones.
const displayMembers = [...topMembers].reverse();

const overlapClass = size === 'sm' ? '-space-x-2' : size === 'md' ? '-space-x-2.5' : '-space-x-3';
---

{sorted.length > 0 && (
    <div class:list={["flex items-center justify-end shrink-0", className]}>
        <!-- Leftmost '+' symbol if more members exist than the limit -->
        {remainingCount > 0 && (
            <span
                class="text-xs font-semibold text-text-muted mr-1.5 select-none"
                title={`${remainingCount} more member${remainingCount > 1 ? 's' : ''}`}
            >
                +
            </span>
        )}

        <!-- Overlapping avatars in right-to-left priority (highest on far right) -->
        <div class:list={["flex items-center", overlapClass]}>
            {displayMembers.map((member) => (
                <div
                    class="group/avatar relative transition-transform duration-200 hover:scale-110 hover:z-30 cursor-pointer"
                    title={member.name}
                >
                    <Avatar
                        avatar={member.avatar}
                        src={member.avatarUrl}
                        alt={member.name}
                        size={size}
                        loading={loading}
                    />
                </div>
            ))}
        </div>

        {/* Commented out right-side count for potential future reuse:
        {(remainingCount > 0 || reserveCountSpace) && (
            <div class="w-7 shrink-0 text-right pl-1">
                {remainingCount > 0 && (
                    <span class="text-xs font-semibold text-text-muted select-none">
                        +{remainingCount}
                    </span>
                )}
            </div>
        )}
        */}
    </div>
)}
