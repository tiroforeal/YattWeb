---
import Card from '../UI/Card.astro';
import Badge from '../UI/Badge.astro';

interface Props {
    title: string;
    slug: string;
    date?: string;
    location?: string;
    excerpt?: string;
    imageUrl?: string;
}

const { title, slug, date, location, excerpt, imageUrl } = Astro.props;
---

<Card href={`/activities/${slug}`} class="group flex flex-col h-full">
    {imageUrl && (
            <div class="relative aspect-video w-full overflow-hidden bg-ink-900">
                <img
                        src={imageUrl}
                        alt={title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                />
            </div>
    )}

    <div class="flex flex-1 p-5 justify-between gap-4">
        <div class="flex-1 space-y-2">
            <div class="flex items-center gap-2">
                {date && <Badge>{new Date(date).toLocaleDateString()}</Badge>}
                {<Badge> · </Badge>}
                {location && <Badge class="text-ink-500">{location}</Badge>}
            </div>

            <h3 class="text-lg font-semibold text-text-primary transition-colors group-hover:text-accent">
                {title}
            </h3>

            {excerpt && <p class="text-sm text-text-muted line-clamp-2">{excerpt}</p>}
        </div>

        <span class="mt-auto shrink-0 self-end text-xs font-medium text-ink-500 group-hover:text-text-primary transition-colors">
      View event &rarr;
    </span>
    </div>
</Card>