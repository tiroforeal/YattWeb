---
interface Props {
    href?: string;
    class?: string;
    overflow?: 'hidden' | 'visible';
}

const { href, class: className, overflow = 'hidden' } = Astro.props;
const Tag = href ? 'a' : 'div'; // dynamic tag
---

<Tag
        href={href}
        class:list={[
            "group block rounded-card bg-surface border border-border-subtle",
            overflow === 'hidden' ? 'overflow-hidden' : 'overflow-visible',
            "transition hover:border-text-primary",
            className,
        ]}
>
    <slot />
</Tag>