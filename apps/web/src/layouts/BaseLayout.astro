---
import '../styles/global.css';
import Sidebar from '../components/Navigation/Sidebar.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Outdoor Sports Club</title>

    <!-- Synchronous theme loader script prevents flash of unstyled theme (FOUC) -->
    <script is:inline>
        (() => {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
</head>
<body class="bg-bg-base text-text-primary font-sans min-h-screen flex antialiased selection:bg-accent selection:text-white">
    <!-- Fixed Sidebar on the Left -->
    <Sidebar />

    <!-- Main Page Content Area: generous standard width and responsive padding -->
    <main class="flex-1 min-w-0 px-6 py-8 md:px-12 md:py-10 max-w-7xl w-full mx-auto">
        <slot />
    </main>
</body>
</html>
