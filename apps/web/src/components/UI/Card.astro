---
interface Props {
    href?: string;
    class?: string;
    overflow?: 'hidden' | 'visible';
}

const { href, class: className, overflow = 'hidden' } = Astro.props;
const Tag = href ? 'a' : 'div'; // dynamic tag
---

<Tag
        href={href}
        class:list={[
            "group block rounded-card bg-surface border border-border-subtle shadow-xs",
            overflow === 'hidden' ? 'overflow-hidden' : 'overflow-visible',
            href ? "transition-all duration-200 hover:border-accent hover:shadow-md" : "transition-all duration-200",
            className,
        ]}
>
    <slot />
</Tag>