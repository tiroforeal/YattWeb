---
import { Image } from 'astro:assets';
import { urlForImage } from '../../sanity/lib/url-for-image';
import type { SanityImageSource } from '@sanity/image-url';

interface Props {
    src?: string | null;
    avatar?: SanityImageSource | null;
    alt: string;
    size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
    class?: string;
    loading?: 'lazy' | 'eager';
}

const { src, avatar, alt, size = 'lg', class: className, loading = 'eager' } = Astro.props;

const avatarPixelDimensions: Record<string, number> = {
    sm: 32,
    md: 48,
    lg: 64,
    xl: 80,
    '2xl': 96,
};

const dimension = avatarPixelDimensions[size] ?? avatarPixelDimensions.lg;

const resolvedSrc = avatar
    ? urlForImage(avatar).width(dimension * 2).height(dimension * 2).fit('crop').auto('format').url()
    : src;

const sizeClasses = {
    sm: 'w-8 h-8 text-xs',
    md: 'w-12 h-12 text-sm',
    lg: 'w-16 h-16 text-base',
    xl: 'w-20 h-20 text-lg',
    '2xl': 'w-24 h-24 text-xl',
};

const ringClass = size === 'sm' ? 'ring-1 ring-surface group-hover/avatar:ring-accent' : 'ring-2 ring-surface group-hover/avatar:ring-accent';

const initials = alt
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase() || '?';
---

<div
    class:list={[
        "relative shrink-0 rounded-full border border-border-subtle group-hover/avatar:border-accent bg-surface shadow-xs aspect-square flex items-center justify-center select-none overflow-hidden transition-all duration-200",
        ringClass,
        sizeClasses[size] ?? sizeClasses.lg,
        className,
    ]}
>
    {resolvedSrc ? (
        <Image
            src={resolvedSrc}
            alt={alt}
            width={dimension}
            height={dimension}
            class="w-full h-full object-cover rounded-full"
            loading={loading}
        />
    ) : (
        <span class="font-semibold text-text-muted uppercase tracking-wider">
            {initials}
        </span>
    )}
</div>

