---
import Card from '../UI/Card.astro';
import Badge from '../UI/Badge.astro';

interface Props {
    title: string;
    date?: string;
    location?: string;
    excerpt?: string;
    imageUrl?: string;
    slug: string;
}

const {
    title,
    date,
    location,
    excerpt,
    imageUrl,
    slug } = Astro.props;
---
<Card href={`/activities/${slug}`}>
    {imageUrl && <img src={imageUrl} alt={title} class="h-48 w-full object-cover" loading="lazy" />}
    <div class="p-5 space-y-2">
        <div class="flex items-center justify-between gap-3">
            <h3 class="text-xl font-semibold text-text-primary">{title}</h3>
            <Badge>{date ? new Date(date).toLocaleDateString() : 'TBA'}{location && ` · ${location}`}</Badge>
        </div>
        {excerpt && (<p class="text-text-muted text-sm">{excerpt}</p>)}
    </div>
</Card>
