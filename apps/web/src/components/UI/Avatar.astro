---
import { urlForImage } from '../../sanity/lib/url-for-image';
import type { SanityImageSource } from '@sanity/image-url';

interface Props {
    src?: string | null;
    avatar?: SanityImageSource | null;
    alt: string;
    size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
    class?: string;
}

const { src, avatar, alt, size = 'lg', class: className } = Astro.props;

const resolvedSrc = avatar
    ? urlForImage(avatar).width(200).height(200).fit('crop').auto('format').url()
    : src;

const sizeClasses = {
    sm: 'w-8 h-8 text-xs',
    md: 'w-12 h-12 text-sm',
    lg: 'w-16 h-16 text-base',
    xl: 'w-20 h-20 text-lg',
    '2xl': 'w-24 h-24 text-xl',
};

const ringClass = size === 'sm' ? 'ring-2 ring-surface' : 'ring-4 ring-surface';

const initials = alt
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase() || '?';
---

<div
    class:list={[
        "relative shrink-0 rounded-full border-2 border-border-subtle bg-surface shadow-md aspect-square flex items-center justify-center select-none overflow-hidden",
        ringClass,
        sizeClasses[size] ?? sizeClasses.lg,
        className,
    ]}
>
    {resolvedSrc ? (
        <img
            src={resolvedSrc}
            alt={alt}
            class="w-full h-full object-cover rounded-full"
            loading="lazy"
        />
    ) : (
        <span class="font-semibold text-text-muted uppercase tracking-wider">
            {initials}
        </span>
    )}
</div>
