---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityCard from '../../components/Activities/ActivityCard.astro';
import { sanityClient } from 'sanity:client';

const activities = await sanityClient.fetch(`
  *[_type == "activityPostType"] | order(eventDate desc) {
    title,
    "slug": slug.current,
    eventDate,
    location,
    excerpt,
    "imageUrl": mainImage.asset->url,
    "attendees": attendees[]->{
      name,
      role,
      avatar,
      priority
    }
  }
`);
---

<BaseLayout title="Club Activities">
    <header class="mb-12">
        <h1 class="text-4xl font-extrabold text-text-primary tracking-tight">YATT Activities</h1>
        <p class="text-text-muted mt-2 text-base">Explore outdoor trips, hikes, and events hosted by our club.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {activities.map((item: any, index: number) => (
                <ActivityCard
                        title={item.title}
                        slug={item.slug}
                        date={item.eventDate}
                        location={item.location}
                        excerpt={item.excerpt}
                        imageUrl={item.imageUrl}
                        attendees={item.attendees}
                        loading={index < 3 ? 'eager' : 'lazy'}
                />
        ))}
    </div>
</BaseLayout>