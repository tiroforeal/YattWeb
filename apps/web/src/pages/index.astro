    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-800 p-6 rounded-lg shadow-md">
            <h2 class="text-2xl font-bold text-emerald-400 mb-4">About Us</h2>
            <p class="text-slate-300">YATT YATT YATT YATT YATT</p>
        </div>
    </section>

</BaseLayout>

