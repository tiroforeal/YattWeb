---

import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PortableText as PortableTextInternal } from 'astro-portabletext';
import PortableText from "../../components/Media/PortableText.astro";
import AvatarGroup from '../../components/UI/AvatarGroup.astro';

export async function getStaticPaths() {
    const activities = await sanityClient.fetch(`*[_type == "activityPostType"]{ "slug": slug.current }`);

    // @ts-ignore — Sanity result type is not inferred here
    return activities.map((item) => ({
        params: { slug: item.slug },
    }));
}

const { slug } = Astro.params;

const activity = await sanityClient.fetch(
    `*[_type == "activityPostType" && slug.current == $slug][0]{
    title,
    eventDate,
    location,
    description,
    "imageUrl": mainImage.asset->url,
    body,
    "attendees": attendees[]->{
      name,
      role,
      avatar,
      priority
    }
  }`,
    { slug }
);
---

<BaseLayout title={activity.title}>
    <article class="max-w-4xl">
        <!--<a href="/activities" class="text-sm font-medium text-accent hover:text-accent-hover mb-6 inline-flex items-center gap-1 transition-colors">
            &larr; Back to all activities
        </a>
-->
        <!-- Page Header with generous vertical spacing to content below -->
        <header class="mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-text-primary">
                {activity.title}
            </h1>
            <div class="flex items-center justify-between gap-4 mb-3 flex-wrap">
                <div class="flex items-center space-x-3 text-sm text-accent font-semibold">
                    <span>{activity.eventDate ? new Date(activity.eventDate).toLocaleDateString(undefined, { dateStyle: 'long' }) : 'Date TBA'}</span>
                    {activity.location && <span>&bull; {activity.location}</span>}
                </div>

                {activity.attendees && activity.attendees.length > 0 && (
                    <AvatarGroup members={activity.attendees} size="md" />
                )}
            </div>
        </header>

        <div class="prose-custom">
            <PortableText portableText={activity.body} />
        </div>
    </article>
</BaseLayout>