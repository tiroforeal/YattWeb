---
import { Image } from 'astro:assets';
import { urlForImage } from '../../sanity/lib/url-for-image';

interface GalleryImage {
    asset: any;
    alt?: string;
    caption?: string;
    loading?: 'lazy' | 'eager';
}

interface Props {
    node: {
        title?: string;
        images?: GalleryImage[];
    };
}

const { node } = Astro.props;
const { title, images = [] } = node;

// Process images to determine optimal dimensions and URLs
const processedImages = images.map((image, idx) => {
    const ref = image?.asset?._ref || image?.asset?._id || '';
    const dimensionsMatch = ref.match(/-(\d+)x(\d+)-/);
    const originalWidth = dimensionsMatch ? parseInt(dimensionsMatch[1], 10) : 1200;
    const originalHeight = dimensionsMatch ? parseInt(dimensionsMatch[2], 10) : 800;

    const displayWidth = Math.min(originalWidth, 1200);
    const displayHeight = Math.round((originalHeight / originalWidth) * displayWidth);
    const url = urlForImage(image.asset).width(displayWidth).auto('format').url();
    // High-resolution source for the popup modal view (up to 2400px width for retina screens)
    const fullResUrl = urlForImage(image.asset).width(Math.min(originalWidth, 2400)).auto('format').url();

    return {
        ...image,
        url,
        fullResUrl,
        width: displayWidth,
        height: displayHeight,
        alt: image.alt || `Gallery image ${idx + 1}`,
        caption: image.caption || '',
    };
});

const galleryDataJson = JSON.stringify(
    processedImages.map((img) => ({
        url: img.fullResUrl,
        alt: img.alt,
        caption: img.caption,
    }))
);
---

{processedImages.length > 0 && (
    <figure class="my-8 gallery-figure">
        {title && (
            <h3 class="text-xl font-bold text-text-primary mb-3 tracking-tight">
                {title}
            </h3>
        )}

        {processedImages.length === 1 ? (
            /* Single Image fallback with click-to-enlarge popup */
            <div class="relative w-full h-[420px] sm:h-[500px] md:h-[580px] rounded-xl overflow-hidden bg-surface-hover/50 dark:bg-black/30 border border-border-subtle shadow-md flex items-center justify-center p-2 md:p-4">
                <button
                    type="button"
                    class="slide-zoom-btn group/zoom relative w-full h-full flex items-center justify-center cursor-zoom-in focus:outline-none"
                    data-index="0"
                    aria-label="Enlarge image"
                >
                    <Image
                        src={processedImages[0].url}
                        alt={processedImages[0].alt}
                        width={processedImages[0].width}
                        height={processedImages[0].height}
                        class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg group-hover/zoom:scale-[1.01] transition-transform duration-200"
                        loading="eager"
                    />
                    <span class="absolute bottom-3 right-3 opacity-0 group-hover/zoom:opacity-100 transition-opacity flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-black/60 text-white text-xs font-medium backdrop-blur-sm pointer-events-none">
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                        </svg>
                        <span>Click to enlarge</span>
                    </span>
                </button>
            </div>
        ) : (
            /* Interactive Carousel Slider with consistent height and uncropped dimensions */
            <div
                class="gallery-slider relative w-full h-[420px] sm:h-[500px] md:h-[580px] overflow-hidden rounded-xl border border-border-subtle bg-surface-hover/50 dark:bg-black/30 shadow-md select-none group focus:outline-none focus:ring-2 focus:ring-accent"
                data-total={processedImages.length}
                data-gallery={galleryDataJson}
                role="region"
                aria-label={title || "Image Gallery"}
            >
                <!-- Slides Track: slides are laid out horizontally and translated -->
                <div class="slides-track flex h-full transition-transform duration-300 ease-out">
                    {processedImages.map((img, idx) => (
                        <div class="slide min-w-full shrink-0 h-full relative flex items-center justify-center p-2 md:p-4">
                            <button
                                type="button"
                                class="slide-zoom-btn group/zoom relative w-full h-full flex items-center justify-center cursor-zoom-in focus:outline-none"
                                data-index={idx}
                                aria-label={`Enlarge image ${idx + 1}: ${img.alt}`}
                            >
                                <Image
                                    src={img.url}
                                    alt={img.alt}
                                    width={img.width}
                                    height={img.height}
                                    class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg group-hover/zoom:scale-[1.01] transition-transform duration-200"
                                    loading={idx === 0 ? 'eager' : 'lazy'}
                                />
                                <span class="absolute bottom-3 right-3 opacity-0 group-hover/zoom:opacity-100 transition-opacity flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-black/60 text-white text-xs font-medium backdrop-blur-sm pointer-events-none">
                                    <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                                    </svg>
                                    <span>Click to enlarge</span>
                                </span>
                            </button>
                        </div>
                    ))}
                </div>

                <!-- Image Counter Badge (Top Right) -->
                <div class="absolute top-4 right-4 z-10 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface/85 backdrop-blur-md border border-border-subtle text-xs font-semibold text-text-primary shadow-sm pointer-events-none">
                    <svg class="size-3.5 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                    <span class="slide-counter">1 / {processedImages.length}</span>
                </div>

                <!-- Previous Button -->
                <button
                    type="button"
                    class="prev-btn absolute left-4 top-1/2 -translate-y-1/2 z-10 flex size-10 items-center justify-center rounded-full bg-surface/85 backdrop-blur-md border border-border-subtle text-text-primary hover:bg-surface hover:text-accent hover:scale-105 active:scale-95 shadow-md transition-all cursor-pointer"
                    aria-label="Previous slide"
                >
                    <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </button>

                <!-- Next Button -->
                <button
                    type="button"
                    class="next-btn absolute right-4 top-1/2 -translate-y-1/2 z-10 flex size-10 items-center justify-center rounded-full bg-surface/85 backdrop-blur-md border border-border-subtle text-text-primary hover:bg-surface hover:text-accent hover:scale-105 active:scale-95 shadow-md transition-all cursor-pointer"
                    aria-label="Next slide"
                >
                    <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </button>

                <!-- Navigation Dots (Bottom Center) -->
                <div class="dots-container absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface/80 backdrop-blur-md border border-border-subtle shadow-xs">
                    {processedImages.map((_, idx) => (
                        <button
                            type="button"
                            class={`dot-btn size-2.5 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-accent scale-125' : 'bg-text-muted/40 hover:bg-text-muted'}`}
                            aria-label={`Go to image ${idx + 1}`}
                            data-index={idx}
                        />
                    ))}
                </div>
            </div>
        )}

        <!-- Dynamic Caption under gallery -->
        <figcaption class="slide-caption text-center text-xs text-text-muted mt-2.5 italic min-h-[1.25rem]">
            {processedImages[0]?.caption || ''}
        </figcaption>

        <!-- Lightbox Modal Dialog (HTML5 Standard <dialog>) -->
        <dialog
            class="lightbox-dialog fixed inset-0 m-0 p-0 w-screen h-screen max-w-none max-h-none bg-transparent border-0 outline-none z-50"
            data-gallery={galleryDataJson}
            aria-label="Enlarged image preview"
        >
            <!-- Dimmed and blurred backdrop layer -->
            <div class="lightbox-backdrop flex flex-col items-center justify-center w-full h-full p-4 sm:p-8 bg-black/25 backdrop-blur-md relative cursor-zoom-out select-none">
                <!-- Close Button (Top Right) -->
                <button
                    type="button"
                    class="lightbox-close absolute top-4 right-4 z-50 flex size-11 items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/50"
                    aria-label="Close enlarged view (Esc)"
                    title="Close (Esc)"
                >
                    <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>

                {processedImages.length > 1 && (
                    <>
                        <!-- Previous button inside modal -->
                        <button
                            type="button"
                            class="lightbox-modal-prev absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-50 flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/50"
                            aria-label="Previous image (Left Arrow)"
                            title="Previous image"
                        >
                            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                            </svg>
                        </button>

                        <!-- Next button inside modal -->
                        <button
                            type="button"
                            class="lightbox-modal-next absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-50 flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/50"
                            aria-label="Next image (Right Arrow)"
                            title="Next image"
                        >
                            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                            </svg>
                        </button>
                    </>
                )}

                <!-- Image and Caption Box: Native <img> tag enables right-click "Copy Image", "Save Image As", etc. -->
                <div class="lightbox-content relative flex flex-col items-center justify-center max-w-[92vw] max-h-[85vh] cursor-default select-auto">
                    <img
                        class="lightbox-img max-w-[92vw] max-h-[78vh] w-auto h-auto object-contain rounded-lg shadow-2xl transition-opacity duration-150 select-auto"
                        src=""
                        alt=""
                    />
                    <p class="lightbox-caption text-center text-sm text-neutral-300 mt-3 max-w-2xl px-4 min-h-[1.25rem]"></p>
                    {processedImages.length > 1 && (
                        <div class="lightbox-counter mt-1.5 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-xs font-medium text-white/90">
                            1 / {processedImages.length}
                        </div>
                    )}
                </div>
            </div>
        </dialog>
    </figure>
)}

<script>
    interface GalleryItem {
        url: string;
        alt: string;
        caption: string;
    }

    function initGalleries() {
        const figures = document.querySelectorAll<HTMLElement>('.gallery-figure');

        figures.forEach((fig) => {
            if (fig.dataset.initialized === 'true') return;
            fig.dataset.initialized = 'true';

            const slider = fig.querySelector<HTMLElement>('.gallery-slider');
            const track = slider?.querySelector<HTMLElement>('.slides-track');
            const counter = slider?.querySelector<HTMLElement>('.slide-counter');
            const prevBtn = slider?.querySelector<HTMLButtonElement>('.prev-btn');
            const nextBtn = slider?.querySelector<HTMLButtonElement>('.next-btn');
            const dots = slider?.querySelectorAll<HTMLButtonElement>('.dot-btn') || [];
            const caption = fig.querySelector<HTMLElement>('.slide-caption');
            const zoomBtns = fig.querySelectorAll<HTMLButtonElement>('.slide-zoom-btn');

            // Lightbox Modal Elements
            const dialog = fig.querySelector<HTMLDialogElement>('.lightbox-dialog');
            const lightboxImg = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
            const lightboxCaption = dialog?.querySelector<HTMLElement>('.lightbox-caption');
            const lightboxCounter = dialog?.querySelector<HTMLElement>('.lightbox-counter');
            const lightboxClose = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');
            const lightboxPrev = dialog?.querySelector<HTMLButtonElement>('.lightbox-modal-prev');
            const lightboxNext = dialog?.querySelector<HTMLButtonElement>('.lightbox-modal-next');
            const lightboxBackdrop = dialog?.querySelector<HTMLElement>('.lightbox-backdrop');

            const rawData = dialog?.dataset.gallery || slider?.dataset.gallery || '[]';
            const galleryData: GalleryItem[] = JSON.parse(rawData);
            const total = galleryData.length;

            let currentIndex = 0;
            let modalIndex = 0;

            // --- CAROUSEL SLIDER LOGIC ---
            function updateSlide(index: number) {
                if (total <= 1) return;

                if (index < 0) {
                    currentIndex = total - 1;
                } else if (index >= total) {
                    currentIndex = 0;
                } else {
                    currentIndex = index;
                }

                if (track) {
                    track.style.transform = `translateX(-${currentIndex * 100}%)`;
                }

                if (counter) {
                    counter.textContent = `${currentIndex + 1} / ${total}`;
                }

                dots.forEach((dot, idx) => {
                    if (idx === currentIndex) {
                        dot.classList.add('bg-accent', 'scale-125');
                        dot.classList.remove('bg-text-muted/40');
                    } else {
                        dot.classList.remove('bg-accent', 'scale-125');
                        dot.classList.add('bg-text-muted/40');
                    }
                });

                if (caption) {
                    caption.textContent = galleryData[currentIndex]?.caption || '';
                }
            }

            prevBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                updateSlide(currentIndex - 1);
            });

            nextBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                updateSlide(currentIndex + 1);
            });

            dots.forEach((dot) => {
                dot.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const targetIdx = parseInt(dot.dataset.index || '0', 10);
                    updateSlide(targetIdx);
                });
            });

            // Touch swipe on carousel slider
            let startX = 0;
            let startY = 0;
            slider?.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
            }, { passive: true });

            slider?.addEventListener('touchend', (e) => {
                const diffX = e.changedTouches[0].clientX - startX;
                const diffY = e.changedTouches[0].clientY - startY;
                if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
                    if (diffX > 0) {
                        updateSlide(currentIndex - 1);
                    } else {
                        updateSlide(currentIndex + 1);
                    }
                }
            }, { passive: true });

            // Keyboard navigation when carousel slider is focused
            slider?.setAttribute('tabindex', '0');
            slider?.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    updateSlide(currentIndex - 1);
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    updateSlide(currentIndex + 1);
                }
            });

            // --- LIGHTBOX POPUP MODAL LOGIC ---
            function updateModalSlide(index: number) {
                if (index < 0) {
                    modalIndex = total - 1;
                } else if (index >= total) {
                    modalIndex = 0;
                } else {
                    modalIndex = index;
                }

                const item = galleryData[modalIndex];
                if (!item || !lightboxImg) return;

                lightboxImg.style.opacity = '0.5';
                lightboxImg.src = item.url;
                lightboxImg.alt = item.alt;

                lightboxImg.onload = () => {
                    lightboxImg.style.opacity = '1';
                };

                if (lightboxCaption) {
                    lightboxCaption.textContent = item.caption || '';
                }

                if (lightboxCounter) {
                    lightboxCounter.textContent = `${modalIndex + 1} / ${total}`;
                }
            }

            function openModal(index: number) {
                if (!dialog) return;
                modalIndex = index;
                updateModalSlide(modalIndex);

                dialog.showModal();
                document.body.style.overflow = 'hidden';

                window.addEventListener('keydown', handleModalKeyDown);
            }

            function closeModal() {
                if (!dialog || !dialog.open) return;
                dialog.close();
                document.body.style.overflow = '';
                window.removeEventListener('keydown', handleModalKeyDown);

                // Sync the slider behind it with the last viewed modal image
                updateSlide(modalIndex);
            }

            function handleModalKeyDown(e: KeyboardEvent) {
                if (e.key === 'Escape') {
                    closeModal();
                } else if (e.key === 'ArrowLeft' && total > 1) {
                    e.preventDefault();
                    updateModalSlide(modalIndex - 1);
                } else if (e.key === 'ArrowRight' && total > 1) {
                    e.preventDefault();
                    updateModalSlide(modalIndex + 1);
                }
            }

            // Click slide image to open modal
            zoomBtns.forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const idx = parseInt(btn.dataset.index || '0', 10);
                    openModal(idx);
                });
            });

            // Close button inside modal
            lightboxClose?.addEventListener('click', (e) => {
                e.stopPropagation();
                closeModal();
            });

            // Next / Prev buttons inside modal
            lightboxPrev?.addEventListener('click', (e) => {
                e.stopPropagation();
                updateModalSlide(modalIndex - 1);
            });

            lightboxNext?.addEventListener('click', (e) => {
                e.stopPropagation();
                updateModalSlide(modalIndex + 1);
            });

            // Click backdrop outside content to close
            lightboxBackdrop?.addEventListener('click', (e) => {
                if (e.target === lightboxBackdrop) {
                    closeModal();
                }
            });

            // Native dialog cancel event (e.g. Esc press)
            dialog?.addEventListener('cancel', () => {
                document.body.style.overflow = '';
                window.removeEventListener('keydown', handleModalKeyDown);
                updateSlide(modalIndex);
            });
        });
    }

    initGalleries();
    document.addEventListener('astro:page-load', initGalleries);
</script>


